# Copy to .env; `make run` exports these. See docs/configuration.md.

# App
APP_NAME=go-service-template
ENV=local

# HTTP server
HOST=0.0.0.0
PORT=8080
READ_TIMEOUT=60s
WRITE_TIMEOUT=60s

# Logger: debug | info | warn | error
LOG_LEVEL=debug

# Redis (host:port)
REDIS_HOST=localhost:6379

# OpenTelemetry (set OTEL_ENABLED=true when Jaeger is running)
OTEL_ENABLED=false
OTLP_ENDPOINT=localhost:4317
